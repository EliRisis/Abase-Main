# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-only, NEVER expose to the client or commit a real value.
# Used only by trusted server-side code (e.g. the seed script).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL this app is deployed at (used for OAuth redirects, PWA metadata).
# Example: http://localhost:3000 in dev, https://abase.app in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
